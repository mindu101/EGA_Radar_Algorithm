+void RosPorts::configure_radar(const FrameTransform& field_to_map,
+                               double stale_ms, double lost_ms)
+{
+  std::lock_guard<std::mutex> lock(mtx_);
+  radar_to_map_ = field_to_map;
+  cfg_.radar_stale_ms = stale_ms;
+  cfg_.radar_lost_ms = lost_ms;
+}
+
+double RosPorts::radar_age_locked() const
+{
+  if (!radar_received_valid_) return 1e9;
+  const double elapsed_ms = std::chrono::duration<double, std::milli>(
+      std::chrono::steady_clock::now() - radar_received_).count();
+  return radar_source_age_ms_ + std::max(0.0, elapsed_ms);
+}
