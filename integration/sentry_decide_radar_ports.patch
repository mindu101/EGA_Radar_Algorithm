+std::array<Observation::Enemy, 5> RosPorts::radar_enemies()
+{
+  std::lock_guard<std::mutex> lock(mtx_);
+  return radar_age_locked() <= cfg_.radar_stale_ms
+             ? radar_enemies_ : std::array<Observation::Enemy, 5>{};
+}
+
+std::array<Observation::Mate, 5> RosPorts::radar_mates()
